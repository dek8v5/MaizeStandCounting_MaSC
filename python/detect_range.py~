import numpy as np
import cv2
import matplotlib.pyplot as plt
from scipy.ndimage import uniform_filter1d
from scipy.signal import argrelextrema

def smoothdata(data, window_len):
    return uniform_filter1d(data, size=window_len)

def rescale(data):
    return (data - np.min(data)) / (np.max(data) - np.min(data))

def detect_range(img, center_crop, num_ranges, draw, plot_graph, directory):
    # Detect ranges in the whole field
    sum_row = np.sum(center_crop, axis=1)
    h_ori, w_ori, c = img.shape

    lm_range_len = 100000
    while lm_range_len > num_ranges - 1:
        sum_row = smoothdata(sum_row, window_len=round(len(sum_row) / 100))
        lm_row = argrelextrema(sum_row, np.less)[0]
        lm_range_len = len(lm_row)

    sum_row = rescale(sum_row)

    if plot_graph:
        plt.figure()
        x = np.arange(1, len(sum_row) + 1)
        plt.plot(sum_row, x, label='Sum Row')
        plt.plot(sum_row[lm_row], x[lm_row], 'r*', label='Local Minima')
        plt.gca().invert_yaxis()
        plt.title('Plot sum green on height')
        plt.savefig(f"{directory}/range_plot.png")
        plt.close()

    if draw:
        for lm in lm_row:
            cv2.line(img, (0, lm), (w_ori, lm), (16, 255, 239), 5)

    return lm_row, img
