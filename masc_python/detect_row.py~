import numpy as np
import cv2
import matplotlib.pyplot as plt
from scipy.ndimage import uniform_filter1d
from scipy.signal import argrelextrema

def smoothdata(data, window_len):
    return uniform_filter1d(data, size=window_len)

def rescale(data):
    return (data - np.min(data)) / (np.max(data) - np.min(data))

def detect_row(img, center_crop, num_row, range_separator, each_range, draw, plot_graph, directory):
    lm_row_len = 10000

    h_ori, w_ori, c = img.shape

    idx = np.where(range_separator == 1)[0]
    range_separator = np.concatenate(([1], idx, [h_ori]))

    if each_range:
        fig, axs = plt.subplots(1, len(range_separator) - 1, figsize=(15, 5))

        for i in range(len(range_separator) - 1):
            sum_col = np.sum(center_crop[range_separator[i]:range_separator[i+1], :], axis=0)

            while lm_row_len > num_row[i] - 1:
                sum_col = smoothdata(sum_col, window_len=round(len(sum_col) / 200))
                lm_col = argrelextrema(sum_col, np.less)[0]
                lm_row_len = len(lm_col)

            if draw:
                for lm in lm_col:
                    cv2.line(img, (lm, range_separator[i]), (lm, range_separator[i+1]), (16, 255, 239), 5)

            if plot_graph:
                axs[i].plot(sum_col)
                axs[i].plot(lm_col, sum_col[lm_col], 'r*')
                axs[i].set_title('Plot sum green on width')
                axs[i].set_box_aspect(1)

            separator[i, :] = lm_col
            sum_col = np.zeros_like(sum_col)
            lm_row_len = 10000

        if plot_graph:
            plt.savefig(f"{directory}/row_plot.png")
            plt.close()

    else:
        sum_col = np.sum(center_crop, axis=0)

        while lm_row_len > num_row - 1:
            sum_col = smoothdata(sum_col, window_len=round(len(sum_col) / 200))
            lm_col = argrelextrema(sum_col, np.less)[0]
            lm_row_len = len(lm_col)

        sum_col = rescale(sum_col)

        separator = np.tile(lm_col, (len(range_separator) - 1, 1))

        if draw:
            for lm in lm_col:
                cv2.line(img, (lm, 0), (lm, h_ori), (16, 255, 239), 5)

        if plot_graph:
            plt.figure()
            plt.plot(sum_col)
            plt.plot(lm_col, sum_col[lm_col], 'r*')
            plt.title('Plot sum green on width')
            plt.savefig(f"{directory}/row_plot.png")
            plt.close()

    return separator, img
