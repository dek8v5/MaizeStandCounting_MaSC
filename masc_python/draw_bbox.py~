import cv2
import numpy as np

def draw_bbox(img, label, num_class, custColor, label_print):
    #define color map that we want to show on the final result, now this is based on yolov4 color scheme
    ColMap = cv2.applyColorMap(np.arange(256, dtype=np.uint8), cv2.COLORMAP_JET) / 255.0
    randomIndex = np.random.randint(len(ColMap), size=num_class)

    if custColor:
        ColMap = np.array([[255, 2, 255], [220, 150, 40], [70, 230, 70]]) / 255.0
        randomIndex = np.array([0, 1, 2])

    label_str = np.empty(label.shape[0], dtype=object)
    for i in range(num_class):
        if i == 0:
            label_str[label[:, 0] == i] = ['corn {:.2f}'.format(score) for score in label[label[:, 0] == i, 5]]
        elif i == 1:
            label_str[label[:, 0] == i] = ['double {:.2f}'.format(score) for score in label[label[:, 0] == i, 5]]
        else:
            label_str[label[:, 0] == i] = ['triple {:.2f}'.format(score) for score in label[label[:, 0] == i, 5]]

    boxes = label[:, 1:5].astype(int)
    colors = (ColMap[randomIndex[label[:, 0].astype(int)]] * 255).astype(int)

    if label_print:
        for idx, lbl in enumerate(label):
            img = cv2.putText(img, label_str[idx], (boxes[idx, 0], boxes[idx, 1] - 10), cv2.FONT_HERSHEY_SIMPLEX, 1, colors[idx].tolist(), 2, cv2.LINE_AA)

    for idx, box in enumerate(boxes):
        img = cv2.rectangle(img, (box[0], box[1]), (box[0] + box[2], box[1] + box[3]), colors[idx].tolist(), 2)

    return img

