import numpy as np
import pandas as pd

def rmse_eval(pred_count, label_sorted, save_result, directory):
    rmse = np.sqrt(np.mean((pred_count[:, 1] - label_sorted[:, 1]) ** 2))
    if save_result:
        with open(f'{directory}/rmse.txt', 'w') as file:
            file.write(f'RMSE: {rmse}\n')
    return rmse

# Read ground truth file
txt_name = '/data/e/stand_counts/MATLAB/ground_truth/gt_fix/19r_30_400-405.csv'
df = pd.read_csv(txt_name)

# Extract and process data
rowss = df.iloc[:, 0].values
row_int = np.array([int(row[-3:]) for row in rowss])
label = np.column_stack((row_int, df.iloc[:, 1] - df.iloc[:, 3]))
label_sorted = label[np.argsort(label[:, 0])]

# Write sorted label to file
output_label_path = '/data/e/stand_counts/MATLAB/ground_truth/gt_final/19r_30_gt_final.txt'
np.savetxt(output_label_path, label_sorted, delimiter=',')

# Read prediction
pred_txt_name = '/data/e/stand_counts/MATLAB/IMAGES/19r_30/pred_34_32.txt'
pred_count = np.loadtxt(pred_txt_name, delimiter=',')
pred_stand_count = np.column_stack((pred_count[:, 0], pred_count[:, 1]))

# Evaluation
rmse = rmse_count(pred_stand_count, label_sorted, True, '/data/e/stand_counts/MATLAB/IMAGES/19r_30/')
print(f'RMSE: {rmse}')
